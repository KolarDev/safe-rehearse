{
  "name": "safe-rehearse",
  "version": "0.0.0",
  "private": true,
  "description": "SafeRehearse — AI learning and practice platform for frontline social-care training.",
  "packageManager": "pnpm@10.23.0",
  "engines": {
    "node": "^22.22.3 || >=24.15.0"
  },
  "scripts": {
    "dev": "turbo run dev --continue",
    "lite": "turbo run serve --continue",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "simulate": "pnpm --filter voice-agent simulate",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "infra:up": "docker compose up -d --wait",
    "infra:down": "docker compose down",
    "db:migrate": "pnpm --filter api db:migrate",
    "db:seed": "pnpm --filter api db:seed",
    "db:generate": "pnpm --filter api db:generate",
    "db:studio": "pnpm --filter api db:studio",
    "db:validate": "pnpm --filter api db:validate",
    "db:format": "pnpm --filter api db:format"
  },
  "devDependencies": {
    "@types/node": "^24.13.6",
    "prettier": "^3.9.9",
    "turbo": "^2.11.4",
    "typescript": "~6.0.3"
  }
}
