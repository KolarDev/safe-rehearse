# Copy to `.env`. Values below match docker-compose.yml for local development.
# Never commit a populated .env with real credentials.

NODE_ENV=development
# Most detailed log level shown by the API and voice agent: error | warn | info/log | debug | verbose.
# debug shows every transcript line and agent state change; verbose (API only) also shows polling requests.
LOG_LEVEL=debug
# LiveKit's event-loop watchdog. The voice agent defaults to warning only on stalls over 1000ms
# and never sampling stacks (lighter on slow machines). Set WARN_MS=0 to turn it off entirely.
# LIVEKIT_AGENTS_LOOP_BLOCK_WARN_MS=1000
# LIVEKIT_AGENTS_LOOP_BLOCK_STACKS=never

# ── Web (apps/web) ───────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000

# ── API (apps/api) ───────────────────────────────────────
API_PORT=4000
WEB_ORIGIN=http://localhost:3000

# ── Database: PostgreSQL + pgvector ──────────────────────
DATABASE_URL=postgresql://saferehearse:saferehearse@localhost:55432/safe_rehearse?schema=public

# ── Redis / BullMQ (not used yet) ────────────────────────
REDIS_URL=redis://localhost:16379

# ── LiveKit (realtime transport) ─────────────────────────
# Local `livekit-server --dev` (pnpm infra:up:livekit) uses devkey / secret.
# For LiveKit Cloud use wss://<project>.livekit.cloud and your project's key/secret, then `pnpm cloud`.
# See docs/livekit-cloud.md.
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
LIVEKIT_AGENT_NAME=safe-rehearse-agent

# ── Voice agent ↔ API ────────────────────────────────────
# Shared secret the voice agent uses to call /agent/* on the API. Min 16 chars.
AGENT_API_SECRET=local-dev-agent-secret-change-me
# Where the voice agent reaches the API.
SAFE_REHEARSE_API_URL=http://localhost:4000
# Concurrent voice sessions one agent worker accepts (default 4).
# AGENT_MAX_SESSIONS=4

# ── Voice model provider ─────────────────────────────────
# Which adapter the voice agent uses. Available: gemini-live
VOICE_PROVIDER=gemini-live

# Gemini Live (VOICE_PROVIDER=gemini-live)
GOOGLE_API_KEY=
GEMINI_LIVE_MODEL=gemini-2.5-flash-native-audio-preview-12-2025
GEMINI_LIVE_VOICE=Puck
# Optional. Leave unset for native-audio models (they auto-detect and reject codes like en-GB).
GEMINI_LIVE_LANGUAGE=
# Gemini 2.5 "thinking" token budget. Defaults to 0 (off) for lower voice latency; e.g. 512 to enable.
# GEMINI_LIVE_THINKING_BUDGET=0

# Evidence extraction: a Gemini TEXT model reads the exam transcript after the Examiner finishes.
# Uses GOOGLE_API_KEY. Pinned to a stable model so grading stays consistent.
# GEMINI_EVIDENCE_MODEL=gemini-2.5-flash
# GEMINI_EVIDENCE_THINKING_BUDGET=512
# GEMINI_EVIDENCE_TIMEOUT_MS=20000
