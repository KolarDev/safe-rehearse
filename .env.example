# Copy to `.env` and fill in values. Never commit real secrets.

# ── Runtime ──────────────────────────────────────────────
NODE_ENV=development

# ── Web (apps/web) ───────────────────────────────────────
# Public URL of the NestJS API, exposed to the browser.
NEXT_PUBLIC_API_URL=http://localhost:4000

# ── API (apps/api) ───────────────────────────────────────
API_PORT=4000
# Origin allowed to call the API from the browser.
WEB_ORIGIN=http://localhost:3000

# ── Database: PostgreSQL (+ pgvector, later) ─────────────
# e.g. postgresql://USER:PASSWORD@localhost:5432/safe_rehearse?schema=public
DATABASE_URL=

# ── Redis / BullMQ ───────────────────────────────────────
# e.g. redis://localhost:6379
REDIS_URL=

# ── AI / Realtime voice (provider not yet chosen) ───────
# Placeholders only. Nothing reads these yet.
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=
REALTIME_VOICE_PROVIDER=
REALTIME_VOICE_API_KEY=
