# Copy to `.env`. Values below match docker-compose.yml for local development.
# Never commit a populated .env with real credentials.

NODE_ENV=development

# ── Web (apps/web) ───────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000

# ── API (apps/api) ───────────────────────────────────────
API_PORT=4000
WEB_ORIGIN=http://localhost:3000

# ── Database: PostgreSQL + pgvector ──────────────────────
DATABASE_URL=postgresql://saferehearse:saferehearse@localhost:55432/safe_rehearse?schema=public

# ── Redis / BullMQ (not used yet) ────────────────────────
REDIS_URL=redis://localhost:16379

# ── LiveKit (realtime transport) ─────────────────────────
# Local `livekit-server --dev` uses devkey / secret. For LiveKit Cloud, use your project's values.
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
LIVEKIT_AGENT_NAME=safe-rehearse-agent

# ── Voice agent ↔ API ────────────────────────────────────
# Shared secret the voice agent uses to call /agent/* on the API. Min 16 chars.
AGENT_API_SECRET=local-dev-agent-secret-change-me
# Where the voice agent reaches the API.
SAFE_REHEARSE_API_URL=http://localhost:4000

# ── Voice model provider ─────────────────────────────────
# Which adapter the voice agent uses. Available: gemini-live
VOICE_PROVIDER=gemini-live

# Gemini Live (VOICE_PROVIDER=gemini-live)
GOOGLE_API_KEY=
GEMINI_LIVE_MODEL=gemini-2.5-flash-native-audio-preview-12-2025
GEMINI_LIVE_VOICE=Puck
