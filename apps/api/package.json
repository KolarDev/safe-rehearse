    "@nestjs/platform-express": "^12.1.0",
    "@prisma/client": "7.10.0",
    "@safe-rehearse/types": "workspace:*",
    "bullmq": "^6.3.9",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.7",
    "@nestjs/schematics": "^12.0.5",
    "@safe-rehearse/config": "workspace:*",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "eslint": "^10.11.0",
    "source-map-support": "^0.5.21",
    "typescript": "~6.0.2"
  }
