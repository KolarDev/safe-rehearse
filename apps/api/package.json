{
  "name": "api",
  "version": "0.0.0",
  "private": true,
  "description": "SafeRehearse backend (NestJS).",
  "type": "module",
  "scripts": {
    "dev": "prisma generate && nest start --watch --preserveWatchOutput",
    "build": "prisma generate && nest build",
    "start": "nest start",
    "start:dev": "prisma generate && nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint .",
    "typecheck": "prisma generate && tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "db:validate": "prisma validate",
    "db:format": "prisma format"
  },
  "dependencies": {
    "@nestjs/bullmq": "^12.0.0",
    "@nestjs/common": "^12.1.0",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.1.0",
    "@nestjs/platform-express": "^12.1.0",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@safe-rehearse/agent-contracts": "workspace:*",
    "@safe-rehearse/types": "workspace:*",
    "bullmq": "^6.3.9",
    "livekit-server-sdk": "^2.19.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.7",
    "@nestjs/schematics": "^12.0.5",
    "@safe-rehearse/config": "workspace:*",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "dotenv": "^18.0.4",
    "eslint": "^10.11.0",
    "prisma": "7.10.0",
    "source-map-support": "^0.5.21",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "vitest": "^5.0.2"
  }
}
